# HAPi World — Environment Variables Template
# Copy to .env and fill in real values
# NEVER commit the real .env file

# ABBA Agent API
HAPI_AGENT_API_KEY=your_agent_api_key_here

# Moltbook Integration
MOLTBOOK_API_KEY=your_moltbook_key_here
MOLTBOOK_API_KEY_2=your_backup_moltbook_key_here

# HAPi Bank
HAPI_BANK_BASE_URL=https://api.hapi.world
HAPI_BANK_WEBHOOK_SECRET=your_webhook_secret

# Payment Bridges
STRIPE_SECRET_KEY=your_stripe_secret
PAYSTACK_SECRET_KEY=your_paystack_secret

# Platform
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key

# Security
HAPI_PROOF_SIGNING_KEY=your_signing_key
HAPI_SENTINEL_WEBHOOK_URL=https://abba.sentinel/webhook

# NOTE: Actual API key stored securely in ABBA encrypted secrets vault.
# This template is for reference only.
